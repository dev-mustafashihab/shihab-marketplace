// Shihab Marketplace — Phase 1 schema (Auth / Users / RBAC / Audit)
// Full domain (vendors, resources, bookings, orders, payments, ledger) is
// designed in docs/DATABASE.md and will be added per phase.
// Physical columns use snake_case via @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ResourceType {
  VENUE
  STAFF
  EQUIPMENT
  OTHER
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  failedAttempts Int        @default(0) @map("failed_attempts")
  lockedUntil    DateTime?  @map("locked_until")
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  profile       Profile?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  vendor        Vendor?
  bookings      Booking[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  media         Media[]
  customerWallet CustomerWallet?
  consents      UserConsent[]

  @@map("users")
}

model Profile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  firstName     String?  @map("first_name") @db.VarChar(100)
  lastName      String?  @map("last_name") @db.VarChar(100)
  phone         String?  @db.VarChar(30)
  avatarMediaId String?  @map("avatar_media_id") @db.Uuid
  locale        String   @default("ar") @db.VarChar(10)
  // ── توثيق الزبون العادي (KYC مبسط) ──
  fullName     String?   @map("full_name") @db.VarChar(150)
  // النسب المفصل — شاشة تسجيل المحفظة الجديدة (اختياري للتوافق مع العملاء القدامى)
  fatherName         String? @map("father_name") @db.VarChar(100)
  motherName         String? @map("mother_name") @db.VarChar(100)
  motherFatherName   String? @map("mother_father_name") @db.VarChar(100)
  motherMaidenName   String? @map("mother_maiden_name") @db.VarChar(100)
  // حساب المحفظة: 16 رقماً فريداً + بصمة PIN (لا يُخزن PIN صريحاً أبداً)
  walletAccountId String? @unique @map("wallet_account_id") @db.VarChar(16)
  walletPinHash   String? @map("wallet_pin_hash") @db.VarChar(255)
  nationalId   String?   @unique @map("national_id") @db.VarChar(11)
  birthDate    DateTime? @map("birth_date") @db.Date
  governorate  String?   @db.VarChar(50)
  city         String?   @db.VarChar(100)
  address      String?   @db.VarChar(255)
  idFrontUrl   String?   @map("id_front_url") @db.VarChar(500)
  idBackUrl    String?   @map("id_back_url") @db.VarChar(500)
  kycStatus    KycStatus @default(PENDING_DOCS) @map("kyc_status")
  kycNote      String?   @map("kyc_note") @db.VarChar(255)
  consentVersion String? @map("consent_version") @db.VarChar(20)
  consentedAt  DateTime? @map("consented_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// حالة توثيق الزبون — المحفظة لا تتفعل قبل APPROVED
enum KycStatus {
  PENDING_DOCS
  APPROVED
  REJECTED
}

// سجل الموافقات القانونية — كل موافقة: نسخة النص + الوقت + IP
model UserConsent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  version   String   @db.VarChar(20)
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_consents")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  permissions Permission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique @db.VarChar(100)
  name   String @db.VarChar(150)
  roleId String? @map("role_id") @db.Uuid
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("permissions")
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ip            String?   @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  diff      Json?
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ===== Phase 2: Marketplace domain =====

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  nameAr      String  @map("name_ar") @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  iconKey     String? @map("icon_key") @db.VarChar(50)
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  vendors      Vendor[]
  services     Service[]

  @@map("categories")
}

model Media {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  vendorId   String?  @map("vendor_id") @db.Uuid
  kind       String   @default("IMAGE") @db.VarChar(20)
  filePath   String   @map("file_path") @db.VarChar(500)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("media")
}

model Vendor {
  timezone  String @default("Asia/Damascus") @db.VarChar(64)
  id            String       @id @default(uuid()) @db.Uuid
  ownerId       String       @unique @map("owner_id") @db.Uuid
  categoryId    String       @map("category_id") @db.Uuid
  name          String       @db.VarChar(150)
  slug          String       @unique @db.VarChar(170)
  description   String?
  status        VendorStatus @default(PENDING)
  rejectionReason String?    @map("rejection_reason") @db.VarChar(255)
  phone         String?      @db.VarChar(30)
  address       String?      @db.VarChar(255)
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  minPrice      Int?         @map("min_price")
  currency      String       @default("USD") @db.VarChar(3)
  isOpen        Boolean      @default(true) @map("is_open")
  imageUrl      String?      @map("image_url") @db.VarChar(500)
  location      Unsupported("geography(Point,4326)")?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media       Media[]
  category    Category         @relation(fields: [categoryId], references: [id])
  services    Service[]
  products    Product[]
  resources   Resource[]
  bookings    Booking[]
  orders      Order[]
  carts       Cart[]
  wallet      Wallet?
  payouts     Payout[]
  reviews     Review[]
  favorites   Favorite[]

  @@index([categoryId])
  @@index([status])
  @@map("vendors")
}

model Service {
  id          String  @id @default(uuid()) @db.Uuid
  vendorId    String  @map("vendor_id") @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  name        String  @db.VarChar(150)
  description String?
  price       Int
  currency    String  @default("USD") @db.VarChar(3)
  durationMin Int?    @map("duration_min")
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  bookings    Booking[]

  @@index([vendorId])
  @@index([categoryId])
  @@map("services")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  vendorId    String  @map("vendor_id") @db.Uuid
  name        String  @db.VarChar(150)
  description String?
  price       Int
  currency    String  @default("USD") @db.VarChar(3)
  stock       Int?
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([vendorId])
  @@map("products")
}

model Resource {
  id        String       @id @default(uuid()) @db.Uuid
  vendorId  String       @map("vendor_id") @db.Uuid
  name      String       @db.VarChar(150)
  type      ResourceType @default(OTHER)
  capacity  Int?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")

  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  availabilities Availability[]
  bookings     Booking[]

  @@index([vendorId])
  @@map("resources")
}

model Availability {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  weekday    Int // 0=Sunday .. 6=Saturday
  startMin   Int      @map("start_min") // minutes from midnight
  endMin     Int      @map("end_min")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, weekday, startMin, endMin])
  @@index([resourceId])
  @@map("availabilities")
}

// ===== Phase 3: Booking Engine =====

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
  EXPIRED
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  bookingRef      String        @unique @map("booking_ref") @db.VarChar(24)
  customerId      String        @map("customer_id") @db.Uuid
  vendorId        String        @map("vendor_id") @db.Uuid
  resourceId      String        @map("resource_id") @db.Uuid
  serviceId       String?       @map("service_id") @db.Uuid
  status          BookingStatus @default(PENDING)
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  totalPrice      Int           @map("total_price")
  currency        String        @default("USD") @db.VarChar(3)
  customerNote    String?       @map("customer_note") @db.VarChar(500)
  clientRequestId String?       @map("client_request_id") @db.VarChar(64)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer      User                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor        Vendor                 @relation(fields: [vendorId], references: [id])
  resource      Resource               @relation(fields: [resourceId], references: [id])
  service       Service?               @relation(fields: [serviceId], references: [id])
  items         BookingItem[]
  statusHistory BookingStatusHistory[]
  payments      Payment[]
  review        Review?

  @@unique([customerId, clientRequestId])
  @@index([customerId])
  @@index([vendorId])
  @@index([resourceId, startsAt])
  @@map("bookings")
}

model BookingItem {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  kind      String  @db.VarChar(20)
  refId     String? @map("ref_id") @db.Uuid
  name      String  @db.VarChar(150)
  price     Int
  quantity  Int     @default(1)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_items")
}

model BookingStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String   @map("to_status") @db.VarChar(20)
  actorId    String?  @map("actor_id") @db.Uuid
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_status_history")
}

// ===== Phase 4: Orders / Cart / Checkout =====

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderRef        String      @unique @map("order_ref") @db.VarChar(24)
  customerId      String      @map("customer_id") @db.Uuid
  vendorId        String      @map("vendor_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  subtotal        Int
  deliveryFee     Int         @default(0) @map("delivery_fee")
  discount        Int         @default(0)
  total           Int
  currency        String      @default("USD") @db.VarChar(3)
  addressSnapshot String?     @map("address_snapshot") @db.VarChar(500)
  phoneSnapshot   String?     @map("phone_snapshot") @db.VarChar(30)
  note            String?     @db.VarChar(500)
  clientRequestId String?     @map("client_request_id") @db.VarChar(64)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customer       User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  review         Review?

  @@unique([customerId, clientRequestId])
  @@index([customerId])
  @@index([vendorId])
  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid()) @db.Uuid
  orderId  String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  nameSnapshot String @map("name_snapshot") @db.VarChar(150)
  unitPrice Int    @map("unit_price")
  quantity  Int
  lineTotal Int    @map("line_total")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(30)
  toStatus   String   @map("to_status") @db.VarChar(30)
  actorId    String?  @map("actor_id") @db.Uuid
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  customerId String  @unique @map("customer_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ===== Phase 5: Payments / Commission / Ledger / Payouts =====

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WalletTxType {
  SALE
  COMMISSION
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  FAILED
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @unique @map("vendor_id") @db.Uuid
  balance   Int      @default(0)
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")

  vendor      Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

// ── محافظ الزبائن (أساسية: شحن من أدمن/وكيل لاحقاً + دفع حجوزات) ──
model CustomerWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Int      @default(0)
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CustomerWalletTx[]

  @@map("customer_wallets")
}

model CustomerWalletTx {
  id        String               @id @default(uuid()) @db.Uuid
  walletId  String               @map("wallet_id") @db.Uuid
  type      CustomerWalletTxType
  amount    Int // موجب = دخول (شحن/استرداد)، سالب = خروج (دفع حجز)
  currency  String               @default("USD") @db.VarChar(3)
  refType   String?              @map("ref_type") @db.VarChar(20)
  refId     String?              @map("ref_id") @db.Uuid
  note      String?              @db.VarChar(255)
  createdAt DateTime             @default(now()) @map("created_at")

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("customer_wallet_txs")
}

enum CustomerWalletTxType {
  TOPUP // شحن رصيد (أدمن الآن، وكيل شحن لاحقاً)
  PAYMENT // دفع حجز من الرصيد
  REFUND // استرداد لرصيد الزبون
  ADJUSTMENT // تسوية إدارية
}

model WalletTransaction {
  id        String        @id @default(uuid()) @db.Uuid
  walletId  String        @map("wallet_id") @db.Uuid
  type      WalletTxType
  amount    Int
  currency  String        @default("USD") @db.VarChar(3)
  refType   String?       @map("ref_type") @db.VarChar(20)
  refId     String?       @map("ref_id") @db.Uuid
  note      String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  // PHASE 3: منع تكرار الحدث المالي — نفس النوع+المرجع+العملة مرة واحدة فقط
  @@unique([type, refType, refId, currency])
  @@map("wallet_transactions")
}

model Payout {
  id          String      @id @default(uuid()) @db.Uuid
  vendorId    String      @map("vendor_id") @db.Uuid
  amount      Int
  currency    String      @default("USD") @db.VarChar(3)
  status      PayoutStatus @default(REQUESTED)
  note        String?     @db.VarChar(255)
  requestedAt DateTime    @default(now()) @map("requested_at")
  processedAt DateTime?   @map("processed_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("payouts")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String?       @map("booking_id") @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  provider        String        @db.VarChar(30)
  providerEventId String?       @map("provider_event_id") @db.VarChar(100)
  status          PaymentStatus @default(PENDING)
  amount          Int
  currency        String        @default("USD") @db.VarChar(3)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])

  @@unique([provider, providerEventId])
  @@index([bookingId])
  @@index([orderId])
  @@map("payments")
}

// ===== Phase 6: Reviews / Favorites / Notifications =====

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  bookingId  String?  @unique @map("booking_id") @db.Uuid
  orderId    String?  @unique @map("order_id") @db.Uuid
  rating     Int
  comment    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([customerId, bookingId])
  @@unique([customerId, orderId])
  @@index([vendorId])
  @@map("reviews")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@map("favorites")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(150)
  body      String?   @db.VarChar(500)
  refType   String?   @map("ref_type") @db.VarChar(20)
  refId     String?   @map("ref_id") @db.Uuid
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
